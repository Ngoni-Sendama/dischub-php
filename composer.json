{
    "name": "ngoni/dischub-php",
    "description": "A Laravel package for integrating with Dischub API",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Ngoni\\DischubPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ngoni\\DischubPhp\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ngoni\\DischubPhp\\DischubServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
