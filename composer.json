{
    "name": "ngoni/dischub-php",
    "description": "A Laravel package for integrating with the Dischub payments API",
    "keywords": [
        "laravel",
        "dischub",
        "payments",
        "ecocash",
        "innbucks",
        "omari",
        "zimswitch"
    ],
    "homepage": "https://github.com/Ngoni-Sendama/dischub-php",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ngonidzashe Sendama",
            "homepage": "https://github.com/Ngoni-Sendama"
        }
    ],
    "support": {
        "issues": "https://github.com/Ngoni-Sendama/dischub-php/issues",
        "source": "https://github.com/Ngoni-Sendama/dischub-php"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ngoni\\DischubPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ngoni\\DischubPhp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ngoni\\DischubPhp\\DischubServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
